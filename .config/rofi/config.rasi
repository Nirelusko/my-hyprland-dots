/**
 * Consolidated Rofi config
 * =========================
 * Single self-contained config (settings + theme inlined).
 * Original preset pack backed up at ~/.config/rofi-backup-*.
 *
 * To customize, edit the values below:
 *   - COLORS:      @background, @foreground, @selected, ...
 *   - FONT:        the "font" line in the * { } block
 *   - IMAGE:       background-image path (side panel artwork)
 *   - LAYOUT:      window width, padding, spacing throughout
 */

/*****----- Global Properties / Colors -----*****/
* {
    font:                        "Montserrat 11";
    background:                  transparent;
    background-alt:              @selected;
    foreground:                  #FFFFFF;
    selected:                    #0045b9;
    active:                      #002E7D89;
    urgent:                      #FF4488;
    unselected:                  #002E7DF2;
}

/*****----- Configuration (behavior) -----*****/
configuration {
	/*---------- General ----------*/
	modes: "drun,run,filebrowser,window";
	case-sensitive: false;
	cycle: true;
	scroll-method: 0;
	normalize-match: true;
	show-icons: false;
	icon-theme: "Papirus";
	steal-focus: false;
	matching: "normal";
	tokenize: true;

	/*---------- SSH ----------*/
	ssh-client: "ssh";
	ssh-command: "{terminal} -e {ssh-client} {host} [-p {port}]";
	parse-hosts: true;
	parse-known-hosts: true;

	/*---------- Drun ----------*/
	drun-categories: "";
	drun-match-fields: "name,generic,exec,categories,keywords";
	drun-display-format: "{name}";
	drun-show-actions: false;
	drun-url-launcher: "xdg-open";
	drun-use-desktop-cache: false;
	drun-reload-desktop-cache: false;
	drun {
		parse-user:   true;
		parse-system: true;
	}

	/*---------- Run ----------*/
	run-command: "{cmd}";
	run-list-command: "";
	run-shell-command: "{terminal} -e {cmd}";
	run,drun {
		fallback-icon: "application-x-addon";
	}

	/*---------- Window switcher ----------*/
	window-match-fields: "title,class,role,name,desktop";
	window-command: "wmctrl -i -R {window}";
	window-format: "{w} · {c} · {t}";
	window-thumbnail: false;

	/*---------- History & sorting ----------*/
	disable-history: false;
	sorting-method: "normal";
	max-history-size: 25;

	/*---------- Display ----------*/
	display-window: "Windows";
	display-windowcd: "Window CD";
	display-run: "Run";
	display-ssh: "SSH";
	display-drun: "Apps";
	display-combi: "Combi";
	display-keys: "Keys";
	display-filebrowser: "Files";

	/*---------- Misc ----------*/
	terminal: "rofi-sensible-terminal";
	sort: true;
	threads: 0;
	click-to-exit: true;

	/*---------- File browser ----------*/
	filebrowser {
		directories-first: true;
		sorting-method:    "name";
	}

	/*---------- Timeout ----------*/
	timeout {
		action: "kb-cancel";
		delay:  0;
	}
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    height:                      360px;
    width:                       640px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    border-radius:               8px;
    border:                      0;
    padding:                     0;
    cursor:                      "default";
    background-color:            @background;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    background-color:            transparent;
    orientation:                 horizontal;
    children:                    [ "listbox" ];
}


listbox {
    spacing:                     20px;
    padding:                     20px;
    background-color:            @background;
    background-image:            url("~/.local/share/rofi/background.png", height);
    border-radius:               12px;
    orientation:                 vertical;
    children:                    [ "inputbar", "message", "listview" ];
}



dummy {
    background-color:            transparent;
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     15px;
    border-radius:               6px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    children:                    [ "textbox-prompt-colon", "entry" ];
}
textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "";
    background-color:            inherit;
    text-color:                  inherit;
}
entry {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search";
    placeholder-color:           inherit;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     10px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
    border:                      0;
    padding:                     0;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     15px;
    padding:                     8px;
    border-radius:               6px;
    background-color:            #D9000000;
    text-color:                  @foreground;
    cursor:                      pointer;
}
element normal.normal {
    background-color:            @unselected;
    text-color:                  inherit;
}
element normal.urgent {
    background-color:            @urgent;
    text-color:                  @foreground;
}
element normal.active {
    background-color:            @active;
    text-color:                  @foreground;
}
element selected.normal {
    background-color:            @selected;
    text-color:                  @foreground;
}
element selected.urgent {
    background-color:            @urgent;
    text-color:                  @foreground;
}
element selected.active {
    background-color:            @urgent;
    text-color:                  @foreground;
}
element alternate.normal {
    background-color:            @unselected;
    text-color:                  inherit;
}
element alternate.urgent {
    background-color:            @urgent;
    text-color:                  @foreground;
}
element alternate.active {
    background-color:            @active;
    text-color:                  @foreground;
}
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        32px;
    cursor:                      inherit;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

/*****----- Message -----*****/
message {
    background-color:            transparent;
    border:                      0;
}
sidebar {
    border:                      0;
}
textbox {
    padding:                     15px;
    border-radius:               6px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
error-message {
    padding:                     15px;
    border-radius:               8px;
    background-color:            @background;
    text-color:                  @foreground;
}
